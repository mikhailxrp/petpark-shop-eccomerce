Options -Indexes

RewriteEngine On

# Блокировать прямой доступ к служебным папкам и файлам
RewriteRule ^(src|config|database|storage|bin|vendor|tests|\.docs|\.git|\.env)(/|$) - [F,L]
RewriteRule ^(composer\.(json|lock)|phpunit\.xml)$ - [F,L]

# /admin — маршрут PHP-роутера (Controllers/Admin/*, phase-1.md Таск 7),
# хотя public/admin/ существует и как физическая папка (Valex-ассеты/
# html-копии для сверки вёрстки). Без этого правила общее правило ниже
# превращает /admin во внутренний запрос к каталогу public/admin, и
# Apache отдаёт 301 на /public/admin/ раньше, чем срабатывает роутер
RewriteRule ^admin/?$ public/index.php [L]

# Всё остальное → public/index.php
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
