# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитить в git

# Окружение: local | production
APP_ENV=local
APP_URL=http://localhost

# База данных
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Логгер
APP_LOG_LEVEL=error

# SEO-фолбэк (Core/Seo.php) — используются в шаблонах title/description, когда
# seo_title/seo_description сущности не заполнены (ADR-004)
SHOP_NAME=PetPark
SHOP_CITY=Ростов-на-Дону

# Адрес самовывоза (FR-SHIP-004, config.php) — в ТЗ не указан, задаётся здесь
SHOP_PICKUP_ADDRESS=

# Секрет подписи платёжной заглушки ЮMoney (Services/Payment, phase-2 Таск 6) — любая длинная случайная строка
PAYMENT_STUB_SECRET=

# Пароль тестовых пользователей database/seed.php (только local, ≥ 8 символов)
SEED_USER_PASSWORD=

# Email (SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=YourProject
MAIL_ENCRYPTION=tls

# ИИ-помощники (Core/Ai.php, Services/Ai) — провайдер на класс задачи, BR-AI-001.
# yandexgpt | offline (offline = ИИ недоступен, для проверки сценариев без ИИ)
AI_PROVIDER_ANONYMOUS=yandexgpt
AI_PROVIDER_PERSONAL=yandexgpt
AI_YANDEX_KEY=
AI_YANDEX_FOLDER_ID=
AI_YANDEX_MODEL=yandexgpt/latest
# Цена ₽ за 1000 токенов (для расчёта расхода против лимита) — сверить с тарифом
AI_PRICE_PER_1K_TOKENS=0.8000

# Консультант в чате (FR-AI-003). true — демо-режим: не более 10 вопросов на
# посетителя (по cookie). После публикации проекта поставить true.
CHAT_LIMIT_REQUESTS=false
# Ссылки на мессенджеры для сообщения «консультант недоступен» (пусто — не показывается)
CHAT_LINK_TELEGRAM=
CHAT_LINK_MAX=
CHAT_LINK_VK=

# Единый инбокс (FR-CHANNELS-005): Каналы, показываемые в панели «Обращения».
# Коды через запятую: max, telegram, vk, avito. Канал без доступа к API убрать из списка.
CHANNELS_ENABLED=max,telegram,vk,avito
